[Unit]
Description=redBorder Net Tools Agent
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/lib/rvm/rubies/ruby-2.7.5/bin/ruby /opt/redborder-net-tools/redborder_net_tools.rb
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=redborder-net-tools

[Install]
WantedBy=multi-user.target
